# ==============================================================================
# API Configuration
# ==============================================================================
# Base URL for backend APIs and services
VITE_API_URL=http://localhost:8008/api
VITE_BACKEND_URL=https://bioai.redclara.net/api

# ==============================================================================
# Development Authentication & User Context
# ==============================================================================

# VITE_USER_ID:
#   Specifies the unique user identifier (UUID) used during local development.
#   When running the application with the development profile ('dev' / npm run dev),
#   this value is automatically injected into outgoing HTTP requests as the 'x-user-id'
#   header via requestInterceptors to emulate an authenticated user context without
#   requiring full OAuth2/Keycloak token validation.
#   Example: 98c38636-76f6-4281-b319-c3fdb51b0bf5
VITE_USER_ID=98c38636-76f6-4281-b319-c3fdb51b0bf5

# VITE_USER_ROLES:
#   Defines the authorization roles assigned to the simulated user during local development.
#   When running under the development profile ('dev' / npm run dev), this value is
#   automatically attached to outgoing HTTP requests as the 'x-user-roles' header.
#   This allows backend microservices and API gateways to enforce role-based access
#   control (RBAC) and permissions (e.g., researcher, admin).
#   Example: ["researcher"]
VITE_USER_ROLES=["researcher"]
